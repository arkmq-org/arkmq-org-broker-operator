# generated by crd
#
{{template "ssl_header" .}}
{{- /* broker_prometheus uses lowercaseOutputName instead */ -}}
attrNameSnakeCase: true
includeObjectNames:
  - "org.apache.activemq.artemis:broker=*,component=addresses,address=*,subcomponent=queues,routing-type=*,queue=*"
{{- if .Queues}}
includeObjectNameAttributes:
{{- range .Queues}}
  org.apache.activemq.artemis:broker="{{$.BrokerName}}",component=addresses,address="{{.Address}}",subcomponent=queues,routing-type="{{.RoutingType}}",queue="{{.Queue}}":
    - MessageCount
    - ConsumerCount
    - DeliveringCount
    - PersistentSize
{{- end}}
{{- end}}
rules:
  - pattern: "org.apache.activemq.artemis<broker=\"([^\"]+)\", component=addresses, address=\"([^\"]+)\", subcomponent=queues, routing-type=\"([^\"]+)\", queue=\"([^\"]+)\"><>([^:]+):"
    name: broker_queue_$5
    help: $5
    attrNameSnakeCase: true
    type: GAUGE
    labels:
      broker: "$1"
      address: "$2"
      routing_type: "$3"
      queue: "$4"
