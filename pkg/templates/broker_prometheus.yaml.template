# generated by crd
#
{{template "ssl_header" .}}
{{- /* service_prometheus uses attrNameSnakeCase instead */ -}}
lowercaseOutputName: true
lowercaseOutputLabelNames: true
includeObjectNames: [org.apache.activemq.artemis:broker="{{.BrokerName}}"]
includeObjectNameAttributes:
  'org.apache.activemq.artemis:broker="{{.BrokerName}}"':
    - "TotalMessageCount"
    - "TotalMessagesAdded"
    - "TotalMessagesAcknowledged"
rules:
  - pattern: 'org.apache.activemq.artemis<broker="{{.BrokerName}}"><>TotalMessageCount'
    help: Number of pending messages
    name: artemis_total_pending_message_count
    type: GAUGE
  - pattern: 'org.apache.activemq.artemis<broker="{{.BrokerName}}"><>TotalMessagesAcknowledged'
    help: Number of messages consumed since start
    name: artemis_total_consumed_message_count
    type: COUNTER
  - pattern: 'org.apache.activemq.artemis<broker="{{.BrokerName}}"><>TotalMessagesAdded'
    help: Number of messages produced since start
    name: artemis_total_produced_message_count
    type: COUNTER
